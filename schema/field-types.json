    { "name": "group",           "empty": [],     "cast": "group",   "editor": "GroupInput",    "fields": true },
    { "name": "repeater",        "empty": [],     "cast": "rows",    "editor": "RepeaterInput", "fields": true },
    { "name": "table",           "empty": [],     "cast": "table",   "editor": "TableInput" },
    { "name": "header",          "empty": null,   "cast": "none",    "editor": "GroupHeading", "decorative": true },
    { "name": "paragraph",       "empty": null,   "cast": "none",    "editor": "GroupNote",    "decorative": true }
  ]
}
