<header class="site-header">
  <div class="wrap header">
    <div class="header-left">
      <a class="brand" href="/" aria-label="Pillar home">{site.title}</a>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/docs/introduction/" class:active={page.collection === 'docs' && !page.url?.startsWith('/docs/liqx-')}>Documentation</a>
        <a href="/docs/liqx-templates/" class:active={page.url?.startsWith('/docs/liqx-')}>Liqx syntax</a>
        <a href="/blog/" class:active={template === 'blog'}>Changelog</a>
      </nav>
    </div>
    <div class="header-right">
      <span class="site-label">Local-first static site generator</span>
      <a class="header-github" href="https://github.com/mehdilight/pillar" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </div>
  <nav class="mobile-nav" aria-label="Mobile navigation">
    <a href="/docs/introduction/" class:active={page.collection === 'docs' && !page.url?.startsWith('/docs/liqx-')}>Documentation</a>
    <a href="/docs/liqx-templates/" class:active={page.url?.startsWith('/docs/liqx-')}>Liqx syntax</a>
    <a href="/blog/" class:active={template === 'blog'}>Changelog</a>
    <a href="https://github.com/mehdilight/pillar" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
  </nav>
</header>
<schema>
{
  "name": "Header",
  "settings": [
    { "id": "menu", "type": "menu", "label": "Navigation menu", "default": "main" }
  ]
}
</schema>
