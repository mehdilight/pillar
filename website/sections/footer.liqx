<footer class="site-footer">
  <div class="wrap footer-content">
    <div class="footer-brand">
      <a class="brand" href="/">{site.title}</a>
      <p class="footer-tagline">A static site generator with a CMS and visual editor built in. Your site is files in Git.</p>
      <div class="footer-meta">
        <span><i class="ph ph-shield-check"></i> Open source · MIT</span>
      </div>
    </div>
    <if {section.blocks.length}>
      <nav class="footer-cols" aria-label="Footer Navigation">
        {section.blocks.map((block) =>
          <div class="footer-col">
            <div class="footer-col-title">{block.settings.heading || menus[block.settings.menu]?.title}</div>
            <ul class="footer-link-list">
              {(menus[block.settings.menu]?.items ?? []).map((link) =>
                <li>
                  <a href={link.url}>{link.title}</a>
                  <if {link.items}>
                    <ul class="footer-sublinks">
                      {link.items.map((child) => <li><a href={child.url}>{child.title}</a></li>)}
                    </ul>
                  </if>
                </li>
              )}
            </ul>
          </div>
        )}
      </nav>
    </if>
  </div>
  <div class="wrap footer-bottom-bar">
    <span class="copyright">{section.settings.note || 'Pillar — local-first static site generator.'}</span>
    <div class="bottom-nav">
      <a href="/docs/introduction/">Docs</a>
      <a href="/docs/liqx-templates/">Liqx syntax</a>
      <a href="/blog/">Changelog</a>
      <a href="https://github.com/mehdilight/pillar" target="_blank" rel="noopener noreferrer">
        <i class="ph ph-github-logo"></i> GitHub <i class="ph ph-arrow-up-right"></i>
      </a>
    </div>
  </div>
</footer>
<schema>
{
  "name": "Footer",
  "description": "The site footer.",
  "max_blocks": 4,
  "settings": [
    { "id": "note", "type": "text", "label": "Footer note", "default": "Pillar — local-first static site generator." }
  ],
  "blocks": [
    { "type": "link_column", "name": "Link column", "settings": [
      { "id": "menu", "type": "menu", "label": "Link list", "default": "footer" },
      { "id": "heading", "type": "text", "label": "Heading", "info": "Leave empty to use the link list's title." }
    ] }
  ]
}
</schema>
