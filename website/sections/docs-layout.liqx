---
const current = page.url;
const docs = collections.docs.items;
const groups = section.settings.groups;
const keys = groups.map((group) => group.key);
const urls = docs.map((entry) => entry.url);
const at = urls.indexOf(current);
const previous = at > 0 ? docs[at - 1] : null;
const next = at >= 0 && at < docs.length - 1 ? docs[at + 1] : null;
const loose = docs.filter((entry) => !keys.includes(entry.section));
const activeGroup = groups.find((g) => g.key === page.section)?.title ?? '';
---
<div class="wrap docs">
  <details class="docs-navigation" open>
    <summary class="docs-nav-toggle">
      <span>↓ Index — {page.title}</span>
    </summary>
    <aside class="docs-nav" aria-label="Documentation">
      {groups.filter((group) => docs.some((entry) => entry.section === group.key)).map((group) =>
        <div class="docs-group">
          <div class="docs-group-title">{group.title}</div>
          <ul>
            {docs.filter((entry) => entry.section === group.key).map((entry) =>
              <li>
                <a href={entry.url} class:current={entry.url === current}>{entry.title}</a>
              </li>
            )}
          </ul>
        </div>
      )}
      <if {loose.length}>
        <div class="docs-group">
          <div class="docs-group-title">{section.settings.heading}</div>
          <ul>
            {loose.map((entry) =>
              <li>
                <a href={entry.url} class:current={entry.url === current}>{entry.title}</a>
              </li>
            )}
          </ul>
        </div>
      </if>
    </aside>
  </details>
  <article class="prose docs-body doc-content">
    <div class="doc-header">
      <nav class="doc-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Pillar</a>
        <span class="sep">/</span>
        <a href="/docs/introduction/">Docs</a>
        <if {activeGroup}>
          <span class="sep">/</span>
          <span>{activeGroup}</span>
        </if>
        <span class="sep">/</span>
        <span class="current-crumb">{page.title}</span>
      </nav>
      <h1>{page.title}</h1>
      <if {page.summary}><p class="docs-summary">{page.summary}</p></if>
    </div>
    {page.content}
    <nav class="docs-pager" aria-label="Previous and next">
      <if {previous}>
        <a class="docs-pager-link" href={previous.url}>
          <span class="pager-hint">← Previous</span>
          <span class="pager-title">{previous.title}</span>
        </a>
      </if>
      <if {next}>
        <a class="docs-pager-link docs-pager-next" href={next.url}>
          <span class="pager-hint">Next →</span>
          <span class="pager-title">{next.title}</span>
        </a>
      </if>
    </nav>
  </article>
  <aside class="docs-outline-aside" aria-label="Table of contents">
    <div class="docs-outline">
      <div class="docs-outline-title">On this page</div>
      <nav data-page-outline aria-label="Page sections"></nav>
      <div class="docs-outline-footer">
        <a class="edit-link" href="https://github.com/mehdilight/pillar" target="_blank" rel="noopener noreferrer">
          GitHub ↗
        </a>
      </div>
    </div>
  </aside>
</div>
<schema>
{
  "name": "Docs page",
  "description": "A documentation page.",
  "enabled_on": ["doc"],
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading for ungrouped pages", "default": "More" },
    { "id": "groups", "type": "repeater", "label": "Sidebar groups",
      "fields": [
        { "id": "key", "type": "text", "label": "Key" },
        { "id": "title", "type": "text", "label": "Title" }
      ],
      "default": [ { "key": "start", "title": "Start here" } ] }
  ]
}
</schema>
