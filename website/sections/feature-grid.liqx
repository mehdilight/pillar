---
const defaultIcons = ['folder', 'sliders', 'cursor-click', 'git-branch', 'lightning', 'puzzle-piece'];
---
<div class="wrap features-section">
  <div class="section-label">Architecture and capabilities</div>
  <div class="features-grid">
    {section.blocks.map((block, idx) =>
      <div class="feature-item">
        <div class="feature-header">
          <span class="feature-num">0{idx + 1}</span>
          <i class={`ph ph-${block.settings.icon || defaultIcons[idx % defaultIcons.length]}`}></i>
        </div>
        <h3 class="feature-title">{block.settings.title}</h3>
        <p class="feature-body">{block.settings.body}</p>
      </div>
    )}
  </div>
</div>
<schema>
{
  "name": "Feature grid",
  "description": "Editorial grid with Thomas Vimare style reference.",
  "max_blocks": 9,
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading", "default": "Architecture and capabilities" }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "id": "title", "type": "text", "label": "Title", "default": "Title" },
      { "id": "body", "type": "textarea", "label": "Body", "default": "Description" },
      { "id": "icon", "type": "text", "label": "Icon", "default": "" }
    ] }
  ]
}
</schema>
