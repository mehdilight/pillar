<div class="wrap home-hero">
  <div class="hero-copy">
    <h1>{section.settings.heading || 'Your content.\nYour code.\nYour corner of the web.'}</h1>
    <p class="hero-description">{section.settings.subheading || 'A static site generator with a visual editor built in. Write, design, and publish from a folder of files you own.'}</p>
    <div class="install-row">
      <span class="install-prompt-symbol">$</span>
      <code>composer create-project phpmystic/pillar my-site</code>
      <button type="button" class="install-copy-btn" data-copy-install aria-label="Copy install command">Copy</button>
    </div>
    <p class="hero-meta">Requires PHP 8.2+ and Composer. Node.js 22+ for dashboard build.</p>
    <div class="section-indicator">↓ System architecture and workflow</div>
  </div>
</div>
<schema>
{
  "name": "Hero",
  "settings": [
    {"id":"heading","type":"textarea","label":"Heading","default":"Your content.\nYour code.\nYour corner of the web."},
    {"id":"subheading","type":"textarea","label":"Description","default":"A static site generator with a visual editor built in. Write, design, and publish from a folder of files you own."}
  ]
}
</schema>
