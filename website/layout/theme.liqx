<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#171717">
  {content_for_header}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={'site.css' | asset_url}>
  <script src={'site.js' | asset_url} defer></script>
</head>
<body class:documentation={page.collection === 'docs'}>
  <a class="skip-link" href="#main">Skip to content</a>
  {section('header')}
  <main id="main">{content_for_layout}</main>
  {section('footer')}
</body>
</html>
