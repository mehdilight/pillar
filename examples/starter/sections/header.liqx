<div class="wrap header">
  <a class="brand" href="/">{site.title}</a>
  <nav>
    {menus[section.settings.menu].items.map((link) =>
      <div class="nav-item">
        <a href={link.url}>{link.title}</a>
        <if {link.items}>
          <div class="nav-submenu">
            {link.items.map((child) => <a href={child.url}>{child.title}</a>)}
          </div>
        </if>
      </div>
    )}
  </nav>
  <if {section.settings.cta_label}>
    <a class="button" href={section.settings.cta_url}>{section.settings.cta_label}</a>
  </if>
</div>
<schema>
{
  "name": "Header",
  "settings": [
    { "id": "menu", "type": "menu", "label": "Navigation menu", "default": "main" },
    { "id": "cta_label", "type": "text", "label": "Button label", "default": "Sign in" },
    { "id": "cta_url", "type": "url", "label": "Button link", "default": "/about/" }
  ]
}
</schema>
