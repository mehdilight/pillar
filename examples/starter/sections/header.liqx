<div class="wrap header">
  <a class="brand" href="/">{site.title}</a>
  <nav>
    {section.settings.links.split(',').map((link) => <a href={link.split('|')[1].trim()}>{link.split('|')[0].trim()}</a>)}
  </nav>
  <if {section.settings.cta_label}>
    <a class="button" href={section.settings.cta_url}>{section.settings.cta_label}</a>
  </if>
</div>
<schema>
{
  "name": "Header",
  "settings": [
    { "id": "links", "type": "text", "label": "Links",
      "default": "Writing | /blog/, About | /about/",
      "info": "Comma separated, each as \"Label | /url/\"." },
    { "id": "cta_label", "type": "text", "label": "Button label", "default": "Sign in" },
    { "id": "cta_url", "type": "url", "label": "Button link", "default": "/about/" }
  ]
}
</schema>