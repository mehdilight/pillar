<div class="wrap hero" style={`padding-block:${section.settings.padding}px;text-align:${section.settings.align}`}>
  <h1 class="display">{section.settings.heading}</h1>
  <if {section.settings.label}><p class="label">{section.settings.label}</p></if>
  <if {section.settings.subheading}><p class="lede">{section.settings.subheading}</p></if>
  <if {section.settings.cta_label}>
    <a class="button" href={section.settings.cta_url}>{section.settings.cta_label}</a>
  </if>
  <if {section.settings.image}>
    <figure class="hero-media">{section.settings.image | image_tag(section.settings.image_alt, 'hero-image', '(min-width: 1200px) 1152px, calc(100vw - 48px)', 'eager')}</figure>
  </if>
</div>
<schema>
{
  "name": "Hero",
  "description": "A heading, a line of copy, a call to action and an optional image.",
  "settings": [
    { "id": "content_head", "type": "header", "content": "Content" },
    { "id": "heading", "type": "text", "label": "Heading", "default": "Markdown in, HTML out." },
    { "id": "label", "type": "text", "label": "Section label", "default": "Our products" },
    { "id": "subheading", "type": "textarea", "label": "Subheading",
      "default": "A local-first static site generator. Edit here, deploy anywhere." },
    { "id": "cta_label", "type": "text", "label": "Button label", "default": "Read the writing" },
    { "id": "cta_url", "type": "url", "label": "Button link", "default": "/blog/" },
    { "id": "image", "type": "image", "label": "Image" },
    { "id": "image_alt", "type": "text", "label": "Image alt text",
      "info": "Leave empty to use the alt text from the media library." },
    { "id": "style_head", "type": "header", "content": "Appearance" },
    { "id": "align", "type": "radio", "label": "Alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] },
    { "id": "padding", "type": "range", "label": "Vertical padding", "min": 32, "max": 200, "step": 8, "unit": "px", "default": 120 }
  ],
  "presets": [ { "name": "Hero" } ]
}
</schema>
