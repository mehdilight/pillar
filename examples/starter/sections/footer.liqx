<footer class="site-footer">
  <div class="wrap footer">
    <div class="footer-brand">
      <a class="brand" href="/">{site.title}</a>
      <if {section.settings.note}><p class="note">{section.settings.note}</p></if>
    </div>
    <if {section.blocks.length}>
      <nav class="footer-cols" aria-label="Footer" style={`--footer-columns:${section.blocks.length}`}>
        {section.blocks.map((block) =>
          <div class="footer-col">
            <h4>{block.settings.heading || menus[block.settings.menu]?.title}</h4>
            <ul>
              {(menus[block.settings.menu]?.items ?? []).map((link) =>
                <li>
                  <a href={link.url}>{link.title}</a>
                  <if {link.items}>
                    <ul class="footer-sublinks">
                      {link.items.map((child) => <li><a href={child.url}>{child.title}</a></li>)}
                    </ul>
                  </if>
                </li>
              )}
            </ul>
          </div>
        )}
      </nav>
    </if>
  </div>
</footer>
<schema>
{
  "name": "Footer",
  "description": "The site name, a note, and up to four columns of links.",
  "max_blocks": 4,
  "settings": [
    { "id": "note", "type": "text", "label": "Footer note", "default": "© Pillar" },
    { "id": "columns_note", "type": "paragraph",
      "content": "Each column is a block showing one link list. Add, reorder or remove columns in the page tree; edit their links under Navigation." }
  ],
  "blocks": [
    { "type": "link_column", "name": "Link column", "settings": [
      { "id": "menu", "type": "menu", "label": "Link list", "default": "footer" },
      { "id": "heading", "type": "text", "label": "Heading", "info": "Leave empty to use the link list's title." }
    ] }
  ],
  "presets": [
    { "name": "Footer", "blocks": [
      { "type": "link_column", "settings": { "menu": "products", "heading": "Products" } },
      { "type": "link_column", "settings": { "menu": "company", "heading": "Company" } },
      { "type": "link_column", "settings": { "menu": "footer", "heading": "Resources" } }
    ] }
  ]
}
</schema>
