<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {content_for_header}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,100..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={'base.css' | asset_url}>
  <style>
    /* The design tokens, from Site settings → Colors and Layout. */
    :root {
      --color-ink-black: {settings.color_ink || '#0a1217'};
      --color-paper-white: {settings.color_paper || '#ffffff'};
      --color-frost-wash: {settings.color_surface || '#e4eff7'};
      --color-stone-gray: {settings.color_muted || '#85898b'};
      --color-electric-lime: {settings.color_accent || '#cdfe00'};

      --font-sana-serif: "Source Serif 4", ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
      --font-sana-sans: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;

      --text-display: 72px;
      --text-body: 16px;
      --text-caption: 13px;

      --radius-cards: {settings.radius_cards ?? 24}px;
      --radius-buttons: 9999px;

      --page-max: {settings.page_max ?? 1200}px;
      --measure: {settings.measure ?? 720}px;
      --section-gap: {settings.section_gap ?? 64}px;
      --edge-soft: color-mix(in srgb, var(--color-ink-black) 8%, transparent);

      color-scheme: light;
    }
  </style>
</head>
<body>
  {section('header')}
  <main id="main">{content_for_layout}</main>
  {section('footer')}
</body>
</html>
