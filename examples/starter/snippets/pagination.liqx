<if {props.paginate.pages > 1}>
  <nav class="pagination" aria-label="Pagination">
    <if {props.paginate.has_previous}>
      <a class="page prev" href={props.paginate.previous_url}>Previous</a>
      <else><span class="page prev disabled">Previous</span></else>
    </if>

    {props.paginate.parts.map((part) =>
      part.gap
        ? <span class="page gap">{part.title}</span>
        : part.current
          ? <span class="page current" aria-current="page">{part.title}</span>
          : <a class="page" href={part.url}>{part.title}</a>
    )}

    <if {props.paginate.has_next}>
      <a class="page next" href={props.paginate.next_url}>Next</a>
      <else><span class="page next disabled">Next</span></else>
    </if>
  </nav>
</if>
